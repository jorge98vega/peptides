&GLOBAL
  PROJECT system
  RUN_TYPE CELL_OPT
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR analytical

  &DFT
    BASIS_SET_FILE_NAME EMSL_BASIS_SETS
    POTENTIAL_FILE_NAME POTENTIAL

    &MGRID
      CUTOFF 400
    &END MGRID

    &QS
      METHOD GAPW
    &END QS

    &XC
      &XC_FUNCTIONAL BLYP
      &END XC_FUNCTIONAL

      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL BLYP
        &END
      &END VDW_POTENTIAL
    &END XC

    &SCF
      EPS_SCF 1.0E-6
      SCF_GUESS ATOMIC
      MAX_SCF 100
    &END SCF

    &KPOINTS
      SCHEME GAMMA 1 1 2
      FULL_GRID .TRUE.
      PARALLEL_GROUP_SIZE 0
    &END KPOINTS

  &END DFT

  &SUBSYS
    &CELL
      A [angstrom]  20.40000      0.000000      0.000000
      B [angstrom]  0.000000      20.40000      0.000000
      C [angstrom]  0.000000      0.000000      9.900000
      PERIODIC XYZ
    &END CELL

    &TOPOLOGY
      COORD_FILE_NAME  geometry.xyz
      COORD_FILE_FORMAT xyz
      &CENTER_COORDINATES
      &END
    &END TOPOLOGY

    &KIND H
      BASIS_SET 6-31Gxx
      POTENTIAL ALL
    &END KIND

    &KIND C
      BASIS_SET 6-31Gxx
      POTENTIAL ALL
    &END KIND

    &KIND N
      BASIS_SET 6-31Gxx
      POTENTIAL ALL
    &END KIND

    &KIND O
      BASIS_SET 6-31Gxx
      POTENTIAL ALL
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &CELL_OPT
    TYPE DIRECT_CELL_OPT
    OPTIMIZER CG
    MAX_ITER 1000
  &END CELL_OPT
&END MOTION
